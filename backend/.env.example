# Copy to backend/.env and fill in. Placeholders only: never commit real secrets.
APP_NAME=PharmaSource
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite:///./data/app.db
UPLOADS_DIR=data/uploads

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
PROVIDER_TIMEOUT_SECONDS=60

TAVILY_API_KEY=
TAVILY_MAX_RESULTS=8
PAGE_FETCH_TIMEOUT_SECONDS=10
PAGE_FETCH_MAX_BYTES=1500000
RESPECT_ROBOTS=true
# Identify your crawler honestly; include a contact
HTTP_USER_AGENT=PharmaSourceBot/2.0 (+contact: you@example.com)

MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=40000000
IMAGE_MAX_SIDE=1600
MAX_TEXT_CHARS=5000

MAX_ITEMS=10
MAX_CANDIDATES=30
BUDGET_TAVILY_CALLS=12
BUDGET_WEB_SEARCH_CALLS=2
BUDGET_PAGES=30
BUDGET_LLM_CALLS=30
BUDGET_COST_SEARCH_CALLS=6
BUDGET_COST_PAGES=8
BUDGET_COST_LLM_CALLS=8
ITEM_TIMEOUT_SECONDS=180
RESEARCH_CONCURRENCY=2
SSE_POLL_SECONDS=0.5
SSE_IDLE_CLOSE_SECONDS=2.0
SSE_KEEPALIVE_SECONDS=15.0
BROADEN_RETRIES=1
PAGE_CACHE_HOURS=24
OFFER_MAX_AGE_DAYS=180

OVERHEAD_PCT=10
MASS_UNCERTAINTY_PCT=15
UNUSUALLY_LOW_FACTOR=0.6
OUTLIER_FACTOR=3
# Comma-separated extra domains to skip
EXTRA_DENYLIST=

RATE_LIMIT_PER_MINUTE=30
ANALYSE_RATE_LIMIT_PER_MINUTE=10
